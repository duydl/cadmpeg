ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('CAD model exported by cadmpeg'),'2;1');
FILE_NAME('cadmpeg_model','1970-01-01T00:00:00',(''),(''),'cadmpeg-step','cadmpeg','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#2 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#3 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#4 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.000001),#1,'distance_accuracy_value','maximum model space distance');
#5 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#4)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#1,#2,#3)) REPRESENTATION_CONTEXT('Context','3D') );
#6 = CARTESIAN_POINT('',(1.,2.,3.));
#7 = DIRECTION('',(0.,0.,1.));
#8 = DIRECTION('',(1.,0.,0.));
#9 = AXIS2_PLACEMENT_3D('',#6,#7,#8);
#10 = TOROIDAL_SURFACE('',#9,7.,2.);
#11 = DIRECTION('',(0.,0.6,0.8));
#12 = VECTOR('',#11,1.);
#13 = LINE('',#6,#12);
#14 = GEOMETRIC_SET('',(#10,#13));
#15 = CARTESIAN_POINT('',(0.,0.,0.));
#16 = AXIS2_PLACEMENT_3D('',#15,#7,#8);
#17 = APPLICATION_CONTEXT('automotive design');
#18 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#17);
#19 = PRODUCT_CONTEXT('',#17,'mechanical');
#20 = PRODUCT('cadmpeg_model','cadmpeg_model','',(#19));
#21 = PRODUCT_DEFINITION_FORMATION('','',#20);
#22 = PRODUCT_DEFINITION_CONTEXT('part definition',#17,'design');
#23 = PRODUCT_DEFINITION('design','',#21,#22);
#24 = PRODUCT_DEFINITION_SHAPE('','',#23);
#25 = SHAPE_REPRESENTATION('',(#14,#16),#5);
#26 = SHAPE_DEFINITION_REPRESENTATION(#24,#25);
ENDSEC;
END-ISO-10303-21;
